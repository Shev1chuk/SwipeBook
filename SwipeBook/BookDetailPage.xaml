<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SwipeBook.BookDetailPage"
             BackgroundColor="{AppThemeBinding Light=#F5F0E8, Dark=#1C1816}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <!-- Велика обкладинка -->
            <Border BackgroundColor="{AppThemeBinding Light=#E5DDD0, Dark=#3A332D}" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                    HeightRequest="320" WidthRequest="215" HorizontalOptions="Center">
                <Image x:Name="CoverImage" Aspect="AspectFill" />
            </Border>

            <Label x:Name="TitleLabel" FontSize="30" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#3B2F2F, Dark=#F2E9DD}"
                   HorizontalTextAlignment="Center" />
            <Label x:Name="AuthorLabel" FontSize="18" TextColor="{AppThemeBinding Light=#777, Dark=#B3A99C}"
                   HorizontalTextAlignment="Center" />
            <Label x:Name="GenreLabel" FontSize="16" FontAttributes="Italic" TextColor="#B5651D"
                   HorizontalTextAlignment="Center" />
            <Label x:Name="DescriptionLabel" FontSize="17" TextColor="{AppThemeBinding Light=#333, Dark=#E6DDD0}" />

            <Label Text="Мій статус" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#3B2F2F, Dark=#F2E9DD}" Margin="0,10,0,0" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button x:Name="WantButton" Grid.Column="0" Text="Хочу прочитати" FontSize="12"
                        CornerRadius="16" BorderWidth="1" BorderColor="#B5651D" Clicked="OnWantClicked" />
                <Button x:Name="ReadingButton" Grid.Column="1" Text="Читаю" FontSize="12"
                        CornerRadius="16" BorderWidth="1" BorderColor="#B5651D" Clicked="OnReadingClicked" />
                <Button x:Name="DoneButton" Grid.Column="2" Text="Прочитано" FontSize="12"
                        CornerRadius="16" BorderWidth="1" BorderColor="#B5651D" Clicked="OnDoneClicked" />
            </Grid>

            <Label x:Name="StatusLabel" FontSize="15" TextColor="{AppThemeBinding Light=#777, Dark=#B3A99C}" Margin="0,10,0,0" />
            <Button x:Name="ToggleButton" Clicked="OnToggleClicked"
                    BackgroundColor="#B5651D" TextColor="White" CornerRadius="20" />

            <!-- Нове: полиці -->
            <Button Text="📚 Додати на полицю" Clicked="OnShelfClicked" CornerRadius="20"
                    BackgroundColor="Transparent" BorderWidth="1" BorderColor="#B5651D" TextColor="#B5651D" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>