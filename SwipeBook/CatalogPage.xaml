<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SwipeBook.Models"
             x:Class="SwipeBook.CatalogPage"
             Title="Каталог" BackgroundColor="{AppThemeBinding Light=#F5F0E8, Dark=#1C1816}"
             xmlns:services="clr-namespace:SwipeBook.Services">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🌓" Command="{x:Static services:ThemeService.ToggleCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="8">
        <SearchBar x:Name="SearchBar" Placeholder="Назва або автор"
                   TextColor="{AppThemeBinding Light=#3B2F2F, Dark=#F2E9DD}" PlaceholderColor="#999"
                   TextChanged="OnFilterChanged" />
        <Picker x:Name="GenrePicker" Grid.Row="1" Title="Жанр"
                TextColor="{AppThemeBinding Light=#3B2F2F, Dark=#F2E9DD}" TitleColor="{AppThemeBinding Light=#777, Dark=#B3A99C}"
                SelectedIndexChanged="OnFilterChanged" />
        <Label x:Name="CountLabel" Grid.Row="2" TextColor="{AppThemeBinding Light=#777, Dark=#B3A99C}" />

        <CollectionView x:Name="BooksView" Grid.Row="3"
                        SelectionMode="Single" SelectionChanged="OnBookSelected">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Book">
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2522}" StrokeShape="RoundRectangle 16"
                Stroke="{AppThemeBinding Light=#DDD, Dark=#3D3631}" Padding="10">
                        <Grid ColumnDefinitions="64,*" ColumnSpacing="14">
                            <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#E5DDD0, Dark=#3A332D}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 8" WidthRequest="64" HeightRequest="96">
                                <Image Source="{Binding Cover}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="19" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#3B2F2F, Dark=#F2E9DD}" />
                                <Label Text="{Binding Author}" FontSize="15" TextColor="{AppThemeBinding Light=#777, Dark=#B3A99C}" />
                                <Label Text="{Binding Genre}" FontSize="14" FontAttributes="Italic" TextColor="#B5651D" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>