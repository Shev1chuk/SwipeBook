<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SwipeBook.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F5F0E8, Dark=#1C1816}"
             xmlns:services="clr-namespace:SwipeBook.Services">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🌓" Command="{x:Static services:ThemeService.ToggleCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,10,20,10">

        <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,6,0,16">
            <Label Text="SwipeBook" FontSize="28" FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#3B2F2F, Dark=#F2E9DD}" />
            <Label x:Name="CounterLabel" FontSize="14" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#777, Dark=#B3A99C}" />
            <ProgressBar x:Name="ProgressBar" ProgressColor="#B5651D"
                         BackgroundColor="{AppThemeBinding Light=#E5DDD0, Dark=#3A332D}" />
        </VerticalStackLayout>

        <Border x:Name="CardBorder" Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2522}"
                StrokeShape="RoundRectangle 28" StrokeThickness="0" Padding="0" Margin="4,0,4,8">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.18" Radius="22" Offset="0,8" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
            </Border.GestureRecognizers>

            <Grid RowDefinitions="260,*">

                <!-- Обкладинка: градієнт і емодзі позаду, справжня картинка зверху -->
                <Border x:Name="CoverBorder" Grid.Row="0" StrokeThickness="0">
                    <Grid>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                            <Label x:Name="CoverEmoji" FontSize="72" HorizontalOptions="Center" />
                            <Label x:Name="CoverGenre" FontSize="15" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Image x:Name="CoverImage" Aspect="AspectFit" Margin="0,10" />
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="22,18,22,18" Spacing="8">
                        <Label x:Name="TitleLabel" FontSize="26" FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#3B2F2F, Dark=#F2E9DD}" />
                        <Label x:Name="AuthorLabel" FontSize="16"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#777, Dark=#B3A99C}" />
                        <Label x:Name="GenreLabel" IsVisible="False" />
                        <Label x:Name="DescriptionLabel" FontSize="16" Margin="0,8,0,8"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#333, Dark=#E6DDD0}" />

                        <Border BackgroundColor="{AppThemeBinding Light=#FBEFE3, Dark=#3A2A1C}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,8">
                            <Label x:Name="RecommendationLabel" FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#8A4B12, Dark=#E0A96B}" />
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <Border x:Name="LikeStamp" Grid.RowSpan="2" HorizontalOptions="Start" VerticalOptions="Start"
                        Margin="20,24,0,0" Rotation="-14" Opacity="0" InputTransparent="True"
                        Stroke="#43A047" StrokeThickness="4" StrokeShape="RoundRectangle 10"
                        BackgroundColor="#E6FFFFFF" Padding="12,4">
                    <Label Text="ПОДОБАЄТЬСЯ" FontSize="22" FontAttributes="Bold" TextColor="#43A047" />
                </Border>

                <Border x:Name="NopeStamp" Grid.RowSpan="2" HorizontalOptions="End" VerticalOptions="Start"
                        Margin="0,24,20,0" Rotation="14" Opacity="0" InputTransparent="True"
                        Stroke="#E53935" StrokeThickness="4" StrokeShape="RoundRectangle 10"
                        BackgroundColor="#E6FFFFFF" Padding="12,4">
                    <Label Text="НЕ ЦЕ" FontSize="22" FontAttributes="Bold" TextColor="#E53935" />
                </Border>
            </Grid>
        </Border>

        <Label x:Name="InfoLabel" Grid.Row="1" FontSize="22" IsVisible="False"
               HorizontalOptions="Center" VerticalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light=#3B2F2F, Dark=#F2E9DD}" />

        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="48" Margin="0,12,0,8">
            <Button x:Name="DislikeButton" Text="✕" FontSize="30" WidthRequest="76" HeightRequest="76"
                    CornerRadius="38" TextColor="#E53935"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2522}"
                    BorderColor="#E53935" BorderWidth="2" Clicked="OnDislikeClicked"
                    SemanticProperties.Description="Не подобається" />
            <Button x:Name="LikeButton" Text="♥" FontSize="30" WidthRequest="76" HeightRequest="76"
                    CornerRadius="38" TextColor="#43A047"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2522}"
                    BorderColor="#43A047" BorderWidth="2" Clicked="OnLikeClicked"
                    SemanticProperties.Description="Подобається" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>